; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Athanor"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

game_state="*res://scripts/autoload/game_state.gd"
dojo_bridge="*res://scripts/autoload/dojo_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dojo]

config/katana_url="http://localhost:5050"
config/torii/torii_url="http://localhost:8080"
config/torii/worlds=Array[String]([])
config/world_address="0x0"
config/actions_address="0x0"
config/account/address="0x0"
config/account/public_key="0x0"
config/account/private_key="0x0"
config/debug/error=true
config/debug/warning=true
config/debug/info=true
config/debug/success=true
config/debug/debug=true
config/fixed_point/default=128
config/fixed_point/64=40
config/fixed_point/128=60
config/fixed_point/256=123
