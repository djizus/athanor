# Slot deployment configuration — template. Copy to .env.slot or let
# `scripts/deploy.sh` regenerate it after each migrate. Consumed by
# `pnpm slot` (i.e. `vite --mode slot`) via client/src/dojo/config.ts.

VITE_PUBLIC_DEPLOY_TYPE=slot
VITE_PUBLIC_SLOT=zathanor-slot
VITE_PUBLIC_NAMESPACE=athanor_0_1
VITE_PUBLIC_NODE_URL=https://api.cartridge.gg/x/zathanor-slot/katana
VITE_PUBLIC_TORII=https://api.cartridge.gg/x/zathanor-slot/torii
VITE_PUBLIC_MASTER_ADDRESS=0x0
VITE_PUBLIC_MASTER_PRIVATE_KEY=0x0

# Contract addresses — deploy.sh overwrites these with the live addresses
# from manifest_slot.json after sozo migrate.
VITE_PUBLIC_WORLD_ADDRESS=0x0
VITE_PUBLIC_ACTIONS_ADDRESS=0x0
VITE_PUBLIC_LORDS_ADDRESS=0x0
