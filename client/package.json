{
  "name": "athanor-ascend-client",
  "private": true,
  "version": "0.1.0",
  "description": "Athanor:Ascend web client (Three.js + Electron).",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "preview": "vite preview",
    "electron:dev": "pnpm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "starknet": "^9.4.2",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/three": "^0.168.0",
    "electron": "^32.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
