[connection signal="pressed" from="Center/Panel/VBox/SpawnButton" to="." method="_on_spawn_button_pressed"]
[connection signal="pressed" from="Center/Panel/VBox/QuitButton" to="." method="_on_quit_button_pressed"]
[connection signal="pressed" from="SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="value_changed" from="SettingsPanel/SettingsVBox/MusicRow/MusicSlider" to="." method="_on_music_slider_changed"]
[connection signal="value_changed" from="SettingsPanel/SettingsVBox/SfxRow/SfxSlider" to="." method="_on_sfx_slider_changed"]
[connection signal="toggled" from="SettingsPanel/SettingsVBox/MusicRow/MusicToggle" to="." method="_on_music_toggle_toggled"]
[connection signal="toggled" from="SettingsPanel/SettingsVBox/SfxRow/SfxToggle" to="." method="_on_sfx_toggle_toggled"]
