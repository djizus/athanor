[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/branding/logo-in-game-gold.png" id="logo"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.059, 0.067, 0.09, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(540, 470)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Logo" type="TextureRect" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
texture = ExtResource("logo")
expand_mode = 3
stretch_mode = 5
custom_minimum_size = Vector2(0, 100)

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
horizontal_alignment = 1
text = "ATHANOR"

[node name="StatusLabel" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
horizontal_alignment = 1
autowrap_mode = 2
text = "Walk the room, enter the arena, survive tactical combat."

[node name="SpawnButton" type="Button" parent="Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "Enter Dungeon"

[node name="QuitButton" type="Button" parent="Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "Quit"

[node name="SettingsButton" type="Button" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -50.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = 50.0
text = "⚙"
theme_override_font_sizes/font_size = 22

[node name="SettingsPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -280.0
offset_top = 56.0
offset_right = -8.0
offset_bottom = 420.0
visible = false

[node name="SettingsVBox" type="VBoxContainer" parent="SettingsPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SettingsTitle" type="Label" parent="SettingsPanel/SettingsVBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Settings"

[node name="MusicRow" type="HBoxContainer" parent="SettingsPanel/SettingsVBox"]
layout_mode = 2

[node name="MusicToggle" type="CheckButton" parent="SettingsPanel/SettingsVBox/MusicRow"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Music"

[node name="MusicSlider" type="HSlider" parent="SettingsPanel/SettingsVBox/MusicRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.8

[node name="SfxRow" type="HBoxContainer" parent="SettingsPanel/SettingsVBox"]
layout_mode = 2

[node name="SfxToggle" type="CheckButton" parent="SettingsPanel/SettingsVBox/SfxRow"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "SFX"

[node name="SfxSlider" type="HSlider" parent="SettingsPanel/SettingsVBox/SfxRow"]
unique_name_in_owner = true
layout_mode = 2
