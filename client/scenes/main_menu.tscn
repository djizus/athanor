[node name="KeybindTitle" type="Label" parent="SettingsPanel/SettingsVBox"]
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "Movement Keybinds"

[node name="KeybindContainer" type="VBoxContainer" parent="SettingsPanel/SettingsVBox"]
unique_name_in_owner = true
layout_mode = 2
